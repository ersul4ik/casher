# Copy to .env for a local run: cp .env.example .env

# Bot token from @BotFather
BOT_TOKEN=123456789:AA...

# Postgres connection string. On Neon, take it from Connection Details (role with password).
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/cacher

# Public address of the service, e.g. https://casher-arx3.onrender.com
# Empty means long polling, which is what you want locally. On Render it can stay empty
# too: the service reads its own address from RENDER_EXTERNAL_URL. Set it for a custom domain.
BASE_URL=

# Any long random string. Empty means it is derived from BOT_TOKEN.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Comma-separated Telegram ids of admins — they get the /stats command
ADMIN_IDS=

# Defaults applied to newly registered users
DEFAULT_CURRENCY=KGS
DEFAULT_TZ_MINUTES=360

# Deduplication window for identical amounts, in seconds
DEDUP_WINDOW_SECONDS=90

# Port. Render and Koyeb inject their own.
PORT=8080
