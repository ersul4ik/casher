# Скопируй в .env для локального запуска: cp .env.example .env

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...

# Строка подключения к Postgres. Для Neon — из Connection Details, роль с паролем.
# Формат: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/cacher

# Публичный адрес сервиса, например https://cacher-bot.onrender.com
# Пусто = long polling (локальная разработка).
BASE_URL=

# Любая длинная случайная строка. Пусто = выведется из BOT_TOKEN.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Telegram id администраторов через запятую — им доступна команда /stats
ADMIN_IDS=

# Значения по умолчанию для новых пользователей
DEFAULT_CURRENCY=KGS
DEFAULT_TZ_MINUTES=360

# Окно дедупликации одинаковых сумм, секунды
DEDUP_WINDOW_SECONDS=90

# Порт. На Render/Koyeb подставляется платформой.
PORT=8080
